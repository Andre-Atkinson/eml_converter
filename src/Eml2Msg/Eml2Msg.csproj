<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Emit the CLI binary as lowercase 'eml2msg', matching the name the README
         and the Quick Action installer use. Without this it publishes as
         'Eml2Msg' and only resolves on a case-insensitive (default APFS) volume;
         on a case-sensitive one the Quick Action fails with "Converter not found". -->
    <AssemblyName>eml2msg</AssemblyName>
    <!-- Pin the third-party dependency graph (MsgKit and its transitives) in
         packages.lock.json so a restore cannot silently pull a different - or
         tampered - version. The lock is framework-dependent on purpose: it does
         not capture SDK-shipped packages (ILLink, runtime packs), whose versions
         float with the installed runtime and whose content hashes are not
         portable between machines. Enforce it with 'make verify'; the
         self-contained publish restores lock-free so it can ship the latest
         runtime patch. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MsgKit" Version="3.0.6" />
  </ItemGroup>

</Project>
